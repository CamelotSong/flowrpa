{
  "name": "flowrpa-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "reactflow": "^11.11.0",
    "antd": "^5.17.0",
    "@ant-design/icons": "^5.3.0",
    "zustand": "^4.5.0",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.4.0",
    "concurrently": "^8.2.0",
    "wait-on": "^7.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.14.0"
  },
  "build": {
    "appId": "com.flowrpa.desktop",
    "productName": "FlowRPA",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!node_modules"
    ],
    "extraResources": [
      {
        "from": "../engine",
        "to": "engine",
        "filter": ["**/*", "!__pycache__", "!*.pyc"]
      }
    ]
  }
}
